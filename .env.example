# TradeLocker Credentials
# Set these in Replit Secrets (Tools → Secrets), NOT in this file
TL_USERNAME=your_email@example.com
TL_PASSWORD=your_password_here
TL_SERVER=your_server_name

# Dashboard API key — required. Server returns 503 on /api/* until this is set.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
DASHBOARD_API_KEY=replace_with_a_long_random_string

# Optional
PORT=5000
